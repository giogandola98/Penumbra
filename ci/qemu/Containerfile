# Pinned emulation environment: qemu-eos (QEMU 4.2.1 + Canon EOS models) built headless.
# Build:  podman build --network=host -t ml-qemu -f ci/qemu/Containerfile ci/qemu
# CI tags the image with the hash of this file, so QEMU (~10 min) is rebuilt only when this file changes.
#
# Contents (/opt/qemu-eos):
#   bin/qemu-system-arm, bin/qemu-img     arm-softmmu with TCG plugins, VNC, no GUI toolkit
#   plugins/libmagiclantern.so            upstream plugin behind `-d debugmsg` (DryosDebugMsg logging)
#   include/qemu-plugin.h                 plugin API header (our plugins are compiled at job time, see build-plugin.sh)
#   magiclantern/                         upstream ML QEMU tooling (ml_qemu/run.py, cam_config, ml_tests, sd.qcow2.xz)
# plus gcc (plugins), binutils-arm-none-eabi (bare-metal self-test), mtools (SD image), python3-pil (screenshots).
FROM docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS build

# qemu-eos branch qemu-eos-v4.2.1, the one Magic Lantern supports (magiclantern/README.md there).
# Pinned by commit; a git object id is content-addressed, so no extra checksum is needed.
ARG QEMU_EOS_REPO=https://github.com/reticulatedpines/qemu-eos.git
ARG QEMU_EOS_SHA=4b667a1d3c08ab7a55835d15ddbd884fa754946d
# Submodule commit recorded by that tree (ui/keycodemapdb); git.qemu.org is gone, the GitHub mirror has it.
ARG KEYCODEMAPDB_REPO=https://github.com/qemu/keycodemapdb.git
ARG KEYCODEMAPDB_SHA=6b3d716e2b6472eb7189d3220552280ef3d832ce

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential python3 pkg-config git ca-certificates flex bison \
      libglib2.0-dev libpixman-1-dev libfdt-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git init -q qemu-eos \
 && git -C qemu-eos fetch -q --depth=1 "$QEMU_EOS_REPO" "$QEMU_EOS_SHA" \
 && git -C qemu-eos checkout -q FETCH_HEAD \
 && test "$(git -C qemu-eos rev-parse HEAD)" = "$QEMU_EOS_SHA" \
 && rm -rf qemu-eos/ui/keycodemapdb && git init -q qemu-eos/ui/keycodemapdb \
 && git -C qemu-eos/ui/keycodemapdb fetch -q --depth=1 "$KEYCODEMAPDB_REPO" "$KEYCODEMAPDB_SHA" \
 && git -C qemu-eos/ui/keycodemapdb checkout -q FETCH_HEAD \
 && test "$(git -C qemu-eos/ui/keycodemapdb rev-parse HEAD)" = "$KEYCODEMAPDB_SHA" \
 && echo "$QEMU_EOS_SHA" > qemu-eos/QEMU_EOS_SHA \
 && rm -rf qemu-eos/.git qemu-eos/ui/keycodemapdb/.git

# Without .git, configure takes the tree as a release tarball (no submodule fetches).
# System libfdt replaces the dtc submodule; slirp/capstone are not needed (no guest network, no disassembler).
# QEMU 4.2 predates GCC 10+: -fcommon and --disable-werror keep it building with bookworm's GCC 12.
WORKDIR /src/build
RUN ../qemu-eos/configure --prefix=/opt/qemu-eos --target-list=arm-softmmu \
      --enable-plugins --enable-vnc --enable-fdt --disable-docs --disable-werror \
      --disable-gtk --disable-sdl --disable-vte --disable-curses --disable-opengl \
      --disable-slirp --disable-capstone --disable-libusb --disable-usb-redir \
      --disable-spice --disable-xen --disable-guest-agent \
      --extra-cflags=-fcommon \
 && make -j"$(nproc)" \
 && make plugins \
 && mkdir -p /opt/qemu-eos/bin /opt/qemu-eos/plugins /opt/qemu-eos/include \
 && cp arm-softmmu/qemu-system-arm qemu-img /opt/qemu-eos/bin/ \
 && cp tests/plugin/libmagiclantern.so /opt/qemu-eos/plugins/ \
 && cp ../qemu-eos/include/qemu/qemu-plugin.h /opt/qemu-eos/include/ \
 && cp -r ../qemu-eos/magiclantern /opt/qemu-eos/magiclantern \
 && cp ../qemu-eos/QEMU_EOS_SHA /opt/qemu-eos/ \
 && strip /opt/qemu-eos/bin/*


FROM docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

# Runtime libs of qemu-system-arm, plus the job-time tools listed at the top.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libglib2.0-0 libpixman-1-0 libfdt1 zlib1g \
      gcc libc6-dev binutils-arm-none-eabi \
      python3 python3-pil mtools xz-utils ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/qemu-eos /opt/qemu-eos
ENV PATH=/opt/qemu-eos/bin:$PATH
ENV QEMU_EOS=/opt/qemu-eos

# Fail the image build, not a later job, if QEMU cannot start.
RUN qemu-system-arm --version && qemu-system-arm -M help | grep -qw EOSM

WORKDIR /work
